# HealthAgentBench (Laminar fork) — environment template
#
# Copy this file to `.env` at the repo root and fill in the values you need
# (the real `.env` is gitignored). Then load it before any Harbor run:
#
#   cp .env.example .env
#   chmod 600 .env
#   set -a && . ./.env && set +a    # export every variable into the shell

# =============================================================================
# 1. Dataset access
# =============================================================================
# None required. This fork keeps only the `clinical_trial_matching` category,
# which is built from TREC Clinical Trials — topics, relevance judgments and the
# ClinicalTrials.gov corpus snapshots are all public, un-gated downloads from
# trec.nist.gov / www.trec-cds.org. No credentials, no DUA, no login.

# =============================================================================
# 2. Task-generation credentials (scripts/trec_ct only, never the task runtime)
# =============================================================================
# The gold-set auditor (scripts/trec_ct/audit_eligible.py) uses an LLM to decide
# which TREC grade-2 ("eligible") trials are *cleanly* eligible for the patient.
# Only needed when generating new tasks, not when running existing ones.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# =============================================================================
# 3. Coding agent credentials
# =============================================================================
# Claude subscription
# Run `claude setup-token`, then export the token below.
# CLAUDE_CODE_OAUTH_TOKEN=

# Codex subscription
# Log in to Codex on the host and use $HOME/.codex/auth.json, then export the
# variable below.
# CODEX_FORCE_AUTH_JSON=1

# API key
# Codex
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Claude Code
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# =============================================================================
# 4. Laminar tracing (the point of this fork)
# =============================================================================
# LMNR_PROJECT_API_KEY=
# LMNR_BASE_URL=https://api.lmnr.ai
